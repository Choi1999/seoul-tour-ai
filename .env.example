# OpenAI LLM
OPENAI_API_KEY=your_openai_api_key_here
LLM_AI_MODEL=your_model_name_here
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Existing embedding model and ChromaDB
# ChromaDB를 생성할 때 사용한 모델과 반드시 동일해야 합니다.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CHROMA_COLLECTION_NAME=langchain
CHROMA_PERSIST_DIR=chroma_db

# Local source data
DATA_DIR=data
DATA_ENCODING=utf-8-sig
RESTAURANTS_FILE=restaurants_op_merged_20260728.csv
MENUS_FILE=menus_selected_20260727.csv
